{
  "config": {
    "step": {
      "user": {
        "description": "Do you want to setup Service Entities?"
      }
    }
  },
  "services": {
    "set_entity": {
      "name": "Set entity",
      "description": "Set entity state",
      "fields": {
        "entity_id": {
          "name": "Entity ID",
          "description": "entity_id of sensor to create or update",
          "example": "sensor.foobar"
        },
        "state": {
          "name": "State",
          "description": "Update sensor state",
          "example": "42"
        },
        "attributes": {
          "name": "Attributes",
          "description": "Update sensor attributes"
        },
        "icon": {
          "name": "Icon",
          "description": "Update sensor icon",
          "example": "mdi:console"
        },
        "name": {
          "name": "Name",
          "description": "New sensor name (Only used when creating new sensor)",
          "example": "Foobar service-created entity"
        },
        "unit_of_measurement": {
          "name": "Unit of measurement",
          "description": "New sensor units (Only used when creating new sensor)",
          "example": "flubs"
        }
      }
    },
    "delete_entity": {
      "name": "Delete entity",
      "description": "Delete entity",
      "fields": {
        "entity_id": {
          "name": "Entity ID",
          "description": "entity_id of sensor to delete",
          "example": "sensor.foobar"
        }
      }
    }
  }
}
